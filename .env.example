# IrisFlow environment overrides.
# Nested keys use double underscore: IRISFLOW_<SECTION>__<FIELD>=value
# CLI > env > YAML > defaults (see config/loader.py once implemented).

# Camera
# IRISFLOW_CAMERA__DEVICE_ID=0
# IRISFLOW_CAMERA__WIDTH=1280
# IRISFLOW_CAMERA__HEIGHT=720
# IRISFLOW_CAMERA__FPS=30

# Model
# IRISFLOW_MODEL__BACKEND=keras           # keras | onnx
# IRISFLOW_MODEL__PATH=models/gaze_cnn_best.keras

# Logging
# IRISFLOW_LOG__LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
# IRISFLOW_LOG__JSON_FILE=data/logs/irisflow.jsonl
