# Exemplo de configuração de ambiente do IrisGazer Frontend
# Copie este arquivo para .env e ajuste os valores.

# URL base da API HTTP do backend (Python)
VITE_API_URL=http://localhost:8000/api

# URL do WebSocket do backend de Eye Tracking
VITE_WS_URL=ws://localhost:8000/ws/gaze

# PIN de acesso do cuidador. TEMPORÁRIO — enquanto não há backend com autenticação real.
# NÃO commitar valores reais em produção; mover para backend com hash.
VITE_CAREGIVER_PIN=1234
